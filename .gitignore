# Track only the project code, results, notes and deck; course handouts and drafts stay local.
/*
!/.gitignore
!/README.md
!/cot-disclosure/
!/presentation/
!/docs/

# secrets
.env

# generated or heavy
node_modules/
.venv/
__pycache__/
*.pyc
cot-disclosure/cache/
cot-disclosure/logs/
presentation/slide-*.jpg
presentation/*.pdf
*.bak
.DS_Store

# PowerPoint lock files, created while a deck is open
~$*
