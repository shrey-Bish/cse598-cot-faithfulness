# Track only the project code, results, docs and the archive; course handouts and drafts stay local.
/*
!/.gitignore
!/README.md
!/cot-disclosure/
!/archive/
!/docs/
# Claude Code (Nov 5): the team's instructions and shared settings (no AI attribution); personal settings
# (.claude/settings.local.json) and worktrees stay local
!/CLAUDE.md
!/.claude/
/.claude/*
!/.claude/settings.json

# secrets
.env

# generated or heavy
node_modules/
.venv/
__pycache__/
*.pyc
cot-disclosure/cache/
cot-disclosure/logs/
archive/progress-round/presentation/slide-*.jpg
archive/progress-round/presentation/*.pdf
*.bak
.DS_Store

# PowerPoint lock files, created while a deck is open
~$*

# regenerated on demand by cot-disclosure/progress/extract_slides.py
docs/progress/SLIDE_POINTS.md
