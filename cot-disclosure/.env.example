# Copy to .env (gitignored) and fill in. Values are never printed or logged.

# ASU Voyager: https://voyager.rc.asu.edu -> LLM Access -> Create Key
RC_LLM_API_KEY=sk-your-voyager-key
RC_LLM_BASE_URL=https://openai.rc.asu.edu/v1

# Track B closed models: real provider keys only (the adapters refuse the Voyager key)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Spending caps in USD (default 5 each), enforced by providers/budget.py
OPENAI_CAP_USD=5
ANTHROPIC_CAP_USD=5
XAI_CAP_USD=5
